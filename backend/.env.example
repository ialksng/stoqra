# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Replica Set required for multi-document transactions)
# e.g., mongodb://localhost:27017/inventory_db?replicaSet=rs0
# or MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/inventory_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/inventory_db

# Google Gemini Document Intelligence API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Google OAuth2 Credentials for Gmail Ingestion
GMAIL_CLIENT_ID=your_gmail_client_id_here
GMAIL_CLIENT_SECRET=your_gmail_client_secret_here
GMAIL_REFRESH_TOKEN=your_gmail_refresh_token_here
GMAIL_REDIRECT_URI=https://developers.google.com/oauthplayground
# Optional custom search query (defaults to searching any unread PDF attachment in INBOX without keyword restriction)
# GMAIL_SEARCH_QUERY=has:attachment filename:pdf label:INBOX is:unread

# Authentication & Google Login
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com
JWT_SECRET=your_jwt_signing_secret_key_minimum_32_chars

# Low-Stock Alerting & Admin Configuration
ALERT_SENDER_EMAIL=your_alerts_sender_email@gmail.com
ALERT_APP_PASSWORD=your_gmail_app_password_here
ADMIN_ALERT_EMAIL=admin_inventory@yourcompany.com
# Comma-separated list of Google account emails granted Admin access
ADMIN_EMAILS=ialksng@gmail.com, partner@yourcompany.com
